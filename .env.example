# ================== EMOJI STORY GENERATOR - CONFIGURATION ==================
# ⚠️  Renseigne tes clés API : Mistral et ElevenLabs sont REQUISES,
# Hugging Face est optionnel (non utilisé, l'illustration est gratuite).

# --- Base de données ---
DB_HOST=db
DB_PORT=5432
DB_USER=emoji_user
DB_PASSWORD=emoji_pass_secure
DB_NAME=emoji_db
# Base dédiée aux tables internes de n8n (séparée des tables métier)
N8N_DB_NAME=n8n_db

# --- Fuseau horaire ---
TZ=Europe/Paris

# --- Ports exposés ---
FRONTEND_PORT=3000
API_PORT=8000
N8N_PORT=5678

# --- n8n ---
N8N_URL=http://n8n:5678

# --- Clés API IA ---
# Mistral (histoire) : https://console.mistral.ai
MISTRAL_API_KEY=your_mistral_api_key_here
# ElevenLabs (ambiance sonore) : https://elevenlabs.io -> Profile -> API Keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Hugging Face : OPTIONNEL — non utilisé (l'illustration passe par
# Pollinations, gratuit et sans clé). Conservé pour d'éventuels tests.
HUGGINGFACE_API_KEY=your_huggingface_token_here
